{
  "name": "@tsed/tailwind-formio",
  "version": "3.0.0-alpha.12",
  "description": "Tailwind templates for form.io forms.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "tsed-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./tailwind.colors": {
      "types": "./dist/tailwind/colors.d.ts",
      "default": "./dist/tailwind/colors.js"
    }
  },
  "scripts": {
    "build": "vite build && yarn tailwind:build",
    "watch": "vite build --watch",
    "tailwind:build": "tailwindcss -i src/styles/tailwind.css -o build/tailwind.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "cross-env": "7.0.3",
    "lucide-static": "^0.544.0",
    "rimraf": "3.0.2",
    "tailwindcss": "4.3.3",
    "vite": "7.1.5",
    "vite-plugin-ejs": "1.7.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "lucide-static": ">=0.544.0"
  },
  "peerDependenciesMeta": {
    "lucide-static": {
      "optional": true
    }
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 128",
      "safari >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
